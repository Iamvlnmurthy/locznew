  targetType ReportTargetType
  targetId   String           @db.Uuid
  authorId   String           @db.Uuid
  note       String           @db.Text
  createdAt  DateTime         @default(now())

  @@index([targetType, targetId])
  @@map("moderator_notes")
}

/**
 * Images a moderator has already refused.
 * Removing a listing does nothing to stop the same photograph being uploaded again a
 * minute later, which is exactly what someone posting illegal material does. Blocking the
 * image itself is what breaks that loop — the decision is made once and holds.
 * Both hash kinds are stored: SHA-256 catches the identical file, and the perceptual hash
 * catches the same picture re-cropped or re-saved, which is the usual evasion.
 */
/**
 * What people told us when the detected area was wrong.
 * A pincode centroid is the average of its post offices, so on the edge of a code the
 * nearest centroid is often not the area a person would name. Nobody knows that better
 * than the person standing there — and when they correct it, that correction is a fact
 * about a place rather than an opinion.
 * Enough corrections around the same spot outweigh the arithmetic. This is not a model
 * being trained; it is the app remembering what it was told, which is the honest version
 * of the same idea and needs no inference to be useful.
 */
model AreaCorrection {
  id           String                                 @id @db.Uuid
  latitude     Decimal                                @db.Decimal(10, 7)
  longitude    Decimal                                @db.Decimal(10, 7)
  geo          Unsupported("geography(Point, 4326)")?
  // What the arithmetic said, kept so the two can be compared.
  detectedCode String                                 @db.VarChar(6)
  // What the person standing there said instead.
  chosenCode   String                                 @db.VarChar(6)
  // Null for a signed-out visitor: a correction is worth having either way.
  userId       String?                                @db.Uuid
  createdAt    DateTime                               @default(now())

  @@index([detectedCode])
  @@index([chosenCode])
  @@map("area_corrections")
}

model BlockedImageHash {
  id          String   @id @db.Uuid
  // 'SHA256' or 'PERCEPTUAL'
  kind        String   @db.VarChar(20)
  hash        String   @db.VarChar(64)
  // Why, in the moderator's words — this is what an appeal is answered from.
  reason      String   @db.VarChar(300)
  // Which moderation category, matching the banned-keyword vocabulary.
  category    String?  @db.VarChar(60)
  blockedById String   @db.Uuid
  createdAt   DateTime @default(now())

  @@unique([kind, hash])
  @@index([kind])
  @@map("blocked_image_hashes")
}

/**
 * Restricted case metadata for a protected-hash match.
 * No image bytes, provider hash, or signed URL belongs here. The quarantined original
 * remains in object storage; this row only records why ordinary moderation and deletion
 * are no longer allowed to touch it.
 */
model MediaSafetyCase {
  id                String                @id @db.Uuid
  mediaId           String                @unique @db.Uuid
  status            MediaSafetyCaseStatus @default(OPEN)
  provider          String                @db.VarChar(60)
  providerReference String?               @db.VarChar(200)
  reasonCode        String                @db.VarChar(80)
  reportReference   String?               @db.VarChar(200)
  resolutionNote    String?               @db.VarChar(500)
  openedAt          DateTime              @default(now())
  reportedAt        DateTime?
  releasedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  media      ListingMedia           @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  accessLogs MediaSafetyAccessLog[]

  @@index([status, openedAt])
  @@map("media_safety_cases")
}

model MediaSafetyAccessLog {
  id            String                  @id @db.Uuid
  caseId        String                  @db.Uuid
  actorId       String                  @db.Uuid
  action        MediaSafetyAccessAction
  justification String                  @db.VarChar(500)
