model AuditLog {
  id            String   @id @db.Uuid
  actorId       String?  @db.Uuid // null for system actions
  actorRole     String?  @db.VarChar(40)
  action        String   @db.VarChar(80) // listing.approve, user.suspend, settings.update …
  entityType    String   @db.VarChar(60)
  entityId      String?  @db.VarChar(64)
  // Before/after snapshot of changed fields only — never full records, never secrets.
  changes       Json?
  ip            String?  @db.VarChar(64)
  userAgent     String?  @db.VarChar(255)
  correlationId String?  @db.VarChar(64)
  createdAt     DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // Admin forensics: "everything that happened to this entity", newest first.
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([correlationId])
  @@map("audit_logs")
}

