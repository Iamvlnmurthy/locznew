/// Where a claim stands. Separate from BusinessClaimStatus, which describes the business.
enum ClaimReviewStatus {
  PENDING
  APPROVED
  REJECTED
  /// The claimant changed their mind before anybody reviewed it.
  WITHDRAWN
}

/// Somebody asking to take over an imported directory record.
///
/// The whole four-million-record directory rests on this: a scraped business is only useful
/// to its owner once they can take control of it, and only trustworthy to a buyer once a
/// person has stood behind it.
///
/// Reviewed by a human rather than granted on the spot. Handing over a business hands over
/// its listings, its enquiries and its identity in search, and the only evidence anybody has
/// at this stage is a claim typed into a form. An automatic grant would make impersonating a
/// shop a matter of being first.
model BusinessClaim {
  id         String            @id @db.Uuid
  businessId String            @db.Uuid
  claimantId String            @db.Uuid
  status     ClaimReviewStatus @default(PENDING)

  /// What the claimant says their relationship to the business is, in their own words.
  evidence     String  @db.Text
  /// A number a reviewer can ring. Not shown publicly, and not the account's number, because
  /// the shop's landline is often the only thing that proves the connection.
  contactPhone String? @db.VarChar(20)

  /// What the claimant says the business actually is.
  ///
  /// Applied to the business only on approval, never before. An imported record's category
  /// was inferred from map tags and is often wrong, and the owner is the first person able to
  /// correct it — but letting an unreviewed claim rewrite a live record would make the claim
  /// form an edit form for businesses nobody owns yet.
  proposedScale      BusinessScale?
  offeringProposed   OfferingType?
  proposedCategoryId String?        @db.Uuid

  /// Where the claimant was standing when they filed.
  ///
  /// Standing inside the shop is evidence a form cannot fake by typing. Accuracy is stored
  /// with it and checked: a fix accurate to two kilometres that happens to centre nearby
  /// proves nothing, and treating it as proof would be worse than having no signal at all.
  latitude          Decimal? @db.Decimal(10, 7)
  longitude         Decimal? @db.Decimal(10, 7)
  locationAccuracyM Int?

  /// Which independent checks matched, in the order they were evaluated.
  ///
  /// Kept whether or not the claim was granted automatically. When a handover later turns out
  /// to be wrong, this is the only record of why the platform believed it, and without it an
  /// automatic approval cannot be reviewed or improved.
  matchedSignals String[]

  /// True when no person looked at this. Auto-approval is a decision the platform made, and
  /// it must be visible as such — to a reviewer auditing handovers, and to anybody disputing
  /// one later.
  autoApproved Boolean @default(false)

  reviewedById    String?   @db.Uuid
  reviewedAt      DateTime?
  /// Why a claim was refused. A rejection nobody can explain is one nobody can appeal.
  rejectionReason String?   @db.VarChar(400)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  claimant User     @relation("BusinessClaimant", fields: [claimantId], references: [id])
  reviewer User?    @relation("BusinessClaimReviewer", fields: [reviewedById], references: [id])

  /// One live claim per person per business. Without this a single account could flood the
  /// review queue for one shop, and a reviewer would have no way to tell the duplicates apart.
  @@unique([businessId, claimantId, status])
  @@index([status, createdAt])
  @@index([businessId])
  @@map("business_claims")
}

// =====================================================================
// Data Engine — external-source ingestion (see docs/DATA_ENGINE_PLAN.md)
// Additive only: new tables + enums, nothing on existing entities.
// =====================================================================

enum MediaOrigin {
  EXTERNAL // hosted by the source; LocZ keeps a reference only
  LOCZ_UPLOAD // uploaded by a business/user to LocZ object storage
  LOCZ_GENERATED // produced by LocZ (e.g. a rendered map card)
  PERMITTED_CACHE // cached from a source that explicitly allows caching
}

enum SourceTrustLevel {
  OFFICIAL
  VERIFIED_LOCZ_BUSINESS
  LOCZ_PARTNER
  LICENSED_SOURCE
  OPEN_DATA_SOURCE
  COMMUNITY
  UNVERIFIED
}

enum SourceHealth {
  HEALTHY
  DEGRADED
  FAILING
  DISABLED
}

enum IngestionStatus {
  PENDING
  PROCESSED
  FAILED
  SKIPPED
}

enum CityLaunchState {
  PLANNED
  SEEDING
  REVIEW
  ACTIVE
  LIMITED
}

/// A registered external data source. One row per provider/feed. NO API keys here —
/// credentials stay in env/secrets; this row describes the source and its licence gate.
model DataSource {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                 String            @unique
  name                String
  type                String
  docsUrl             String?
  baseUrl             String?
  authMethod          String            @default("none")
  enabled             Boolean           @default(false)
  priority            Int               @default(100)
  trustLevel          SourceTrustLevel  @default(OPEN_DATA_SOURCE)
  refreshSeconds      Int               @default(86400)
  rateLimitPerMin     Int?
  attributionText     String?
  termsReviewed       Boolean           @default(false)
  commercialUse       Boolean           @default(false)
  storagePermitted    Boolean           @default(false)
  cachingPermitted    Boolean           @default(false)
  mediaDisplay        Boolean           @default(false)
  attributionRequired Boolean           @default(false)
  reviewedAt          DateTime?
  reviewNotes         String?
  health              SourceHealth      @default(DISABLED)
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  errorCount          Int               @default(0)
  requestCount        Int               @default(0)
  recordsCreated      Int               @default(0)
  recordsUpdated      Int               @default(0)
  duplicatesRejected  Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  rawRecords          SourceRawRecord[]

  @@index([type, enabled])
}

/// The unmodified payload of one external record, kept for reprocessing, dedup and audit.
/// Never exposed to users (Part 6).
model SourceRawRecord {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId        String          @db.Uuid
  source          DataSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId      String
  hash            String
  rawPayload      Json
  retrievedAt     DateTime        @default(now())
  sourceUpdatedAt DateTime?
  status          IngestionStatus @default(PENDING)
  processingError String?
  h3              String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([sourceId, externalId])
  @@index([status])
  @@index([h3])
}

// ─────────────────────────────────────────────────────────────────────────────
// News intelligence (docs/NEWS_INTELLIGENCE_ARCHITECTURE.md). Ingest once, resolve
// places to coordinates, cluster into events, distribute by PostGIS radius. Public
// projection defaults to headline + summary + source link; body/media are gated on
// each source licence (mirrors the DataSource gate).
// ─────────────────────────────────────────────────────────────────────────────

enum NewsSourceType {
  RSS
  ATOM
  API
  SITEMAP
  NEWS_SITEMAP
  HTML
  GOV
  ALERT
}

/// How much of a source's media LocZ may use. Default is conservative.
enum NewsMediaPolicy {
  MEDIA_DISABLED
  MEDIA_METADATA_ONLY
  MEDIA_LINK_ONLY
  MEDIA_EMBED_ALLOWED
  MEDIA_HOTLINK_ALLOWED
  MEDIA_DOWNLOAD_ALLOWED
  MEDIA_DOWNLOAD_AND_REHOST_ALLOWED
}

/// Verification state of a real-world event. Copy count never promotes a rumour to fact.
enum NewsEventStatus {
  VERIFIED
  HIGH_CONFIDENCE
  REPORTED
  UNVERIFIED
  DISPUTED
  CORRECTED
  RETRACTED
}

/// The role one article plays for an event: the primary report, a supporting independent
/// report, or a syndicated reprint (which must not count as independent confirmation).
enum NewsArticleRole {
  PRIMARY
  SUPPORTING
  SYNDICATED
}

/// Which admin entity a location alias points at. Polymorphic by (type,id) rather than an
/// FK, since an alias can name a state, district, city or locality.
enum AliasEntityType {
  STATE
  DISTRICT
  CITY
  LOCALITY
}

/// A registered news/information source. Config + licence gate; NO credentials here.
/// Optionally linked to a DataSource so the production licence gate is shared.
model NewsSource {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String         @unique
  name         String
  domain       String
  sourceType   NewsSourceType
  language     String         @default("en")
  dataSourceId String?        @db.Uuid // SOFT reference to DataSource — no FK, so the news schema has zero foreign keys into non-news tables and can be lifted to its own server/DB later

  coverageStateId    String? @db.Uuid
  coverageDistrictId String? @db.Uuid
  coverageCityId     String? @db.Uuid
  coverageScope      String  @default("regional")

  crawlAllowed     Boolean      @default(true)
  crawlIntervalSec Int          @default(900)
  reliability      Int          @default(50)
  nextFetchAt      DateTime?
  lastFetchAt      DateTime?
  lastChangeAt     DateTime?
  etag             String?
  lastModified     String?
  failureCount     Int          @default(0)
  status           SourceHealth @default(DISABLED)

  mediaPolicy         NewsMediaPolicy @default(MEDIA_METADATA_ONLY)
  attributionRequired Boolean         @default(true)
  mediaLicense        String?

  requestCount   Int      @default(0)
  articlesFound  Int      @default(0)
  duplicatesSeen Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feeds    NewsFeed[]
  articles NewsArticle[]

  @@index([sourceType, status])
  @@index([nextFetchAt])
  @@index([coverageCityId])
}

/// One feed/sitemap/endpoint URL under a source. A source may have many.
model NewsFeed {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId     String         @db.Uuid
  source       NewsSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  url          String
  feedType     NewsSourceType
  language     String?
  etag         String?
  lastModified String?
  lastFetchAt  DateTime?
  nextFetchAt  DateTime?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  rawDocuments RawNewsDocument[]

  @@unique([sourceId, url])
  @@index([active, nextFetchAt])
}

/// The unmodified fetched payload for one feed item. Idempotency anchor: re-fetching the
/// same content never creates a second row.
model RawNewsDocument {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedId      String          @db.Uuid
  feed        NewsFeed        @relation(fields: [feedId], references: [id], onDelete: Cascade)
  externalId  String
  contentHash String
  rawPayload  Json
  status      IngestionStatus @default(PENDING)
  fetchError  String?
  retrievedAt DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  article NewsArticle?

  @@unique([feedId, externalId])
  @@unique([feedId, contentHash])
  @@index([status])
}

/// A normalized article. Body is nullable and stored only where source policy permits; the
/// default public projection is title + summary + canonicalUrl + publisher.
model NewsArticle {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId String           @db.Uuid
  source   NewsSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  rawDocId String?          @unique @db.Uuid
  rawDoc   RawNewsDocument? @relation(fields: [rawDocId], references: [id], onDelete: SetNull)

  title        String
  summary      String?
  body         String?
  language     String    @default("en")
  canonicalUrl String    @unique
  sourceUrl    String
  publisher    String?
  author       String?
  imageUrl     String?
  category     String?
  publishedAt  DateTime?
  updatedAtSrc DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events NewsEventArticle[]

  @@index([sourceId, publishedAt])
  @@index([publishedAt])
}

/// The canonical, deduplicated real-world event. Carries the geo point (populated by the
/// locz_sync_geo trigger via the migration) that the nearby-feed radius query hits.
model NewsEvent {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String          @unique // SEO URL: locz.in/news/<slug>
  title             String
  summary           String?
  categories        String[]
  severity          Int             @default(0)
  status            NewsEventStatus @default(REPORTED)
  trustScore        Int             @default(0)
  relevanceScore    Int             @default(0)
  originatingAgency String?

  latitude            Decimal?                               @db.Decimal(10, 7)
  longitude           Decimal?                               @db.Decimal(10, 7)
  geo                 Unsupported("geography(Point, 4326)")?
  distributionRadiusM Int                                    @default(5000)
  coverageStateId     String?                                @db.Uuid
  coverageDistrictId  String?                                @db.Uuid
  coverageCityId      String?                                @db.Uuid

  firstSeenAt    DateTime @default(now())
  latestUpdateAt DateTime @default(now())
  sourceCount    Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  articles  NewsEventArticle[]
  locations NewsEventLocation[]
  updates   NewsEventUpdate[]

  @@index([latestUpdateAt])
  @@index([status, latestUpdateAt])
}

/// M:N event to article, with the role each article plays (syndication guard lives here).
model NewsEventArticle {
  eventId   String          @db.Uuid
  event     NewsEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  articleId String          @db.Uuid
  article   NewsArticle     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  role      NewsArticleRole @default(SUPPORTING)
  addedAt   DateTime        @default(now())

  @@id([eventId, articleId])
  @@index([articleId])
}

/// A place an event affects, with resolution confidence. Low confidence pins only at
/// district/state level, never a wrong neighbourhood.
model NewsEventLocation {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String          @db.Uuid
  event      NewsEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entityType AliasEntityType
  entityId   String          @db.Uuid
  confidence Int             @default(0)
  createdAt  DateTime        @default(now())

  @@unique([eventId, entityType, entityId])
  @@index([entityType, entityId])
}

/// Append-only version history of an event (fire started to controlled to casualties).
model NewsEventUpdate {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String    @db.Uuid
  event     NewsEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  summary   String
  changedBy String?
  createdAt DateTime  @default(now())

  @@index([eventId, createdAt])
}

/// The long-term asset: every way a place can be named, mapped to the canonical admin
/// entity. Polymorphic by (entityType, entityId).
model LocationAlias {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aliasNormalized String
  aliasDisplay    String
  entityType      AliasEntityType
  entityId        String          @db.Uuid
  language        String?
  source          String          @default("seed")
  confidence      Int             @default(100)
  createdAt       DateTime        @default(now())

  @@unique([aliasNormalized, entityType, entityId])
  @@index([entityType, entityId])
}
