// LocZ — database schema (source of truth for all applications).
//
// Conventions
//  - UUID primary keys, generated application-side (time-ordered) for index locality.
//  - createdAt / updatedAt on every persistent entity.
//  - deletedAt (soft delete) only on User, Business, Listing, Message — the entities a
//    user can remove but whose history moderation and audit still need. Join tables,
//    counters and logs are hard-deleted or never deleted.
//  - `geo` columns are PostGIS geography(Point,4326). Prisma cannot type them, so they are
//    declared Unsupported and every spatial read/write goes through GeoRepository (ADR-0003).
//    Their GiST indexes live in the SQL migration, not here.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Prisma 7 moved connection URLs out of the schema: the CLI reads them from
  // prisma.config.ts, and the runtime client connects through a driver adapter
  // (see src/prisma/prisma.service.ts). The schema now describes shape only.
  extensions = [postgis, pg_trgm, unaccent, citext]
}

