/// Every search anybody runs, and whether it found anything.
///
/// This is how the vocabulary stops being a guess. A category term list can say what a
/// category *is*; it cannot say what is inside one, and no amount of hand-writing reaches
/// "toor dal", "weighing machine" or "bed bug spray". A search that returns nothing is a
/// person telling us a word we are missing, and after a week in one city that is a real
/// list ranked by how often people actually type it — which beats anything anyone infers.
///
/// Deliberately not personal. There is no user id and no device id: knowing *that* somebody
/// searched for a word is what improves the platform, and knowing *who* only creates a
/// record of what individuals were looking for. The city is kept because demand is local and
/// the whole point is to learn what a particular area wants.
/// A single-use token that lets somebody set a new password.
///
/// The token itself is never stored — only a SHA-256 of it. A reset table in a leaked backup
/// would otherwise be a list of working keys to every account that had recently asked for
/// one, and the window is measured in hours precisely because that is when the risk is real.
///
/// Consumed rather than deleted on use, and kept briefly afterwards, so a second attempt
/// with the same link can be told apart from one that never existed. That distinction is
/// what stops somebody probing whether a token was ever issued.
model PasswordResetToken {
  id     String @id @db.Uuid
  userId String @db.Uuid

  /// SHA-256 of the token that was emailed. The token is shown once and never written down.
  tokenHash String @unique @db.VarChar(64)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  /// What asked for it, for support and for spotting a pattern of attempts. Not the token.
  requestedIp String? @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model SearchQueryLog {
  id String @id @db.Uuid

  /// Lower-cased and trimmed, so counting groups naturally.
  normalisedQuery String @db.VarChar(120)

  cityId     String? @db.Uuid
  pincode    String? @db.VarChar(6)
  categoryId String? @db.Uuid

  resultCount  Int
  /// Split out rather than derived, so "found nothing" can be indexed and counted directly.
  isZeroResult Boolean

  /// Whether the request also carried filters. A zero-result search with five filters set is
  /// a different problem from one with none: the first is over-narrowing, the second is
  /// missing vocabulary, and only the second should feed the term lists.
  hadFilters Boolean @default(false)

  createdAt DateTime @default(now())

  city     City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// The reporting query: what returned nothing, where, and how often.
  @@index([isZeroResult, cityId, createdAt(sort: Desc)])
  @@index([normalisedQuery])
  @@map("search_query_logs")
}

model SearchSubscription {
  id            String    @id @db.Uuid
  userId        String    @db.Uuid
  label         String    @db.VarChar(120)
  query         String?   @db.VarChar(200)
  // Serialised filter set: categoryId, type, priceMin/Max, cityId, radiusKm …
  filters       Json
  cityId        String?   @db.Uuid
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  radiusKm      Int?
  isActive      Boolean   @default(true)
  lastMatchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

