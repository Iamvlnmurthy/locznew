  REQUIREMENT_MATCH
  /// A buyer is told a seller answered their requirement.
  REQUIREMENT_RESPONSE
  NEARBY_OFFER
  JOB_ENQUIRY
  BUSINESS_VERIFICATION_UPDATE
  /// Somebody who asked to take over an imported directory record is told the outcome.
  BUSINESS_CLAIM_UPDATE
  REPORT_RESOLUTION
  SECURITY_ALERT
}

/// What kind of operation a business is.
///
/// The vision asks for home businesses to have a proper identity rather than looking like
/// random classified sellers, and this is the field that carries it. A home baker, a kirana
/// store and a wholesaler need different forms, different badges and different search
/// treatment, and none of that is expressible while they are all just "a business".
///
/// Also what makes an imported directory record honest: a scraped shop is a RETAIL_STORE
/// nobody has claimed, not a seller who signed up.
/// How big the operation is.
///
/// Split out from BusinessType, which conflated two independent questions: HOME_BUSINESS
/// describes scale while SERVICE_PROVIDER describes what is sold, so a home baker and a
/// visiting electrician could not both be described accurately. Buyers filter on these
/// differently — "shops near me" and "someone who comes to my house" are different searches.
enum BusinessScale {
  /// A shop with an address a customer can walk into.
  INDIVIDUAL_SHOP
  /// Run from home. Real, often unregistered, and the majority of what LocZ exists for.
  HOME_BUSINESS
  /// Multiple staff or branches, registered.
  ENTERPRISE
}

/// Whether they sell things, do things, or both.
///
/// Decides what the storefront can even offer. "Ask if they stock this" is meaningless for an
/// electrician, and "book a visit" is meaningless for a kirana shop.
enum OfferingType {
  PRODUCTS
  SERVICES
  BOTH
}

enum BusinessType {
  RETAIL_STORE
  HOME_BUSINESS
  SERVICE_PROVIDER
  PROFESSIONAL
  MANUFACTURER
  WHOLESALER
  DEALER
  OTHER
}

/// How an individual is selling, when they are not trading as a business at all.
///
/// Deliberately separate from `BusinessType` and deliberately not a permanent label: a user
/// is a buyer and a seller at once, and this describes the posting rather than the person.
enum SellerType {
  INDIVIDUAL
  HOME_BUSINESS
  RETAIL_STORE
  SERVICE_PROVIDER
  PROPERTY_OWNER
  BROKER
  EMPLOYER
  EVENT_ORGANISER
}

/// Whether a directory record has found its real owner yet.
///
/// An imported business is real but unclaimed: LocZ knows the shop exists because an open
/// dataset said so, and nobody from that shop has ever logged in. Saying so plainly is the
/// difference between a directory that is useful and one that is misleading.
enum BusinessClaimStatus {
  /// Created by someone who signed up. The ordinary case.
  OWNER_CREATED
  /// Imported from an open dataset; nobody has claimed it.
  UNCLAIMED
  /// Someone has asked to claim it and is waiting on review.
  CLAIM_PENDING
  /// Claimed, reviewed and handed over.
  CLAIMED
}

enum ConversationContext {
  LISTING_ENQUIRY
  BUSINESS_ENQUIRY
  JOB_ENQUIRY
  // A seller answering a buyer's requirement. Distinct from LISTING_ENQUIRY because the
  // roles are reversed: here the seller opens the conversation, about something the buyer
  // asked for rather than something the seller listed.
  REQUIREMENT_ENQUIRY
}

/// How a seller answers a buyer requirement. Deliberately more than yes and no: most real
/// answers are conditional, and forcing them into "available" loses the condition that
/// decides whether the buyer is interested.
enum RequirementResponseKind {
  AVAILABLE
  AVAILABLE_AT_DIFFERENT_PRICE
  SIMILAR_AVAILABLE
  CAN_ARRANGE
  MADE_TO_ORDER
  AVAILABLE_LATER
  NOT_AVAILABLE
}

/// How the buyer would like to receive the thing they are asking for.
enum FulfilmentPreference {
  PICKUP
  DELIVERY
  EITHER
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum Language {
  EN
  TE
  HI
}

enum PlacementType {
  FEATURED
  SPONSORED
  BOOST
  BANNER
}

// =====================================================================
// Identity & access
// =====================================================================

model User {
  id                  String     @id @db.Uuid
  // E.164, e.g. +919876543210. Unique because it is the primary login identifier and is
  // looked up on every OTP request — this index is on the hottest auth path.
  //
  // Nullable since Google sign-up: Google gives a verified email and no number, and the
  // alternative was a Google button that told people to go and fill in the form instead.
  // Postgres permits any number of NULLs under a unique index, so the constraint still
  // does its real job — stopping two accounts from claiming the same number.
  //
  // An account without one is incomplete, not anonymous: sign-up routes straight to
  // /account/phone, and every read of this column must handle null. `phoneVerifiedAt`
  // remains the only proof the number is theirs.
  phoneE164           String?    @unique @db.VarChar(20)
  phoneVerifiedAt     DateTime?
  email               String?    @unique @db.Citext
  emailVerifiedAt     DateTime?
  passwordHash        String?    @db.VarChar(255) // argon2id; null for OTP-only accounts
  displayName         String     @db.VarChar(120)
  avatarMediaId       String?    @db.Uuid
  bio                 String?    @db.VarChar(500)
  preferredLanguage   Language   @default(EN)
  status              UserStatus @default(ACTIVE)
  lastActiveAt        DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  roles           UserRole[]
  devices         Device[]
  sessions        Session[]
  savedLocations  SavedLocation[]
  ownedBusinesses Business[]      @relation("BusinessOwner")
  businessClaims  BusinessClaim[] @relation("BusinessClaimant")
  claimsReviewed  BusinessClaim[] @relation("BusinessClaimReviewer")
  businessStaffOf BusinessStaff[]
  /// How this person sells, when they are not trading as a business. Describes the posting,
  /// not the person: everyone is a buyer and a seller here, and nobody is asked to choose.
  sellerType      SellerType      @default(INDIVIDUAL)

  listings              Listing[]                @relation("ListingOwner")
  requirementResponses  RequirementResponse[]    @relation("RequirementResponder")
  savedListings         SavedListing[]
  savedBusinesses       SavedBusiness[]
  recentlyViewed        RecentlyViewed[]
  conversationsStarted  Conversation[]           @relation("ConversationInitiator")
  conversationsReceived Conversation[]           @relation("ConversationRecipient")
  messages              Message[]
  blocksMade            Block[]                  @relation("Blocker")
  blocksReceived        Block[]                  @relation("Blocked")
  reportsFiled          Report[]                 @relation("Reporter")
  moderationActions     ModerationAction[]       @relation("Moderator")
  suspensions           UserSuspension[]         @relation("SuspendedUser")
  notifications         Notification[]
  notificationPrefs     NotificationPreference[]
  searchSubscriptions   SearchSubscription[]
  passwordResetTokens   PasswordResetToken[]
  auditLogs             AuditLog[]

  // "Active users near a city" and admin listings are the two common scans.
  @@index([status, lastActiveAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model Role {
  id          String   @id @db.Uuid
  name        RoleName @unique
  description String   @db.VarChar(255)
  // Permission strings such as "listing:moderate", "business:verify". Kept as a scalar
  // list rather than a join table: the set is small, admin-managed and read on every request.
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  grantedAt DateTime @default(now())
  grantedBy String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  // Composite PK doubles as the uniqueness constraint — a role cannot be granted twice.
  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Device {
  id         String         @id @db.Uuid
  userId     String         @db.Uuid
  platform   DevicePlatform
  // Stable per-install identifier supplied by the client; unique per user so re-installing
  // replaces rather than accumulates device rows.
  deviceKey  String         @db.VarChar(128)
  name       String?        @db.VarChar(120)
  osVersion  String?        @db.VarChar(60)
  appVersion String?        @db.VarChar(30)
  pushToken  String?        @db.VarChar(512)
  lastSeenAt DateTime       @default(now())
  lastIp     String?        @db.VarChar(64)
  revokedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([userId, deviceKey])
  @@index([pushToken])
  @@map("devices")
}

model Session {
  id                String    @id @db.Uuid
  userId            String    @db.Uuid
  deviceId          String    @db.Uuid
  // SHA-256 of the opaque refresh token. The token itself is never stored (ADR-0007).
  refreshTokenHash  String    @unique @db.VarChar(64)
  // All rotations descend from one login; reuse of a rotated token revokes the whole family.
  familyId          String    @db.Uuid
  previousSessionId String?   @db.Uuid
  expiresAt         DateTime
  rotatedAt         DateTime?
  revokedAt         DateTime?
  revokedReason     String?   @db.VarChar(120)
  ip                String?   @db.VarChar(64)
  userAgent         String?   @db.VarChar(255)
  createdAt         DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  // Drives the expired-session sweeper.
  @@index([expiresAt])
  @@map("sessions")
}

model OtpAttempt {
  id          String    @id @db.Uuid
  phoneE164   String    @db.VarChar(20)
  // SHA-256 of the code. Comparing hashes keeps plaintext OTPs out of the database.
  codeHash    String    @db.VarChar(64)
  purpose     String    @db.VarChar(40) // LOGIN | PHONE_CHANGE | DELETE_CONFIRM
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  expiresAt   DateTime
  ip          String?   @db.VarChar(64)
  deviceKey   String?   @db.VarChar(128)
  createdAt   DateTime  @default(now())

  // The verify path looks up the newest unconsumed attempt for a phone.
  @@index([phoneE164, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("otp_attempts")
}

model AuthLockout {
  id          String   @id @db.Uuid
  // Either a phone number or an IP — one table covers both brute-force surfaces.
  identifier  String   @db.VarChar(80)
  scope       String   @db.VarChar(20) // PHONE | IP
  failedCount Int      @default(0)
  lockedUntil DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, identifier])
  @@index([lockedUntil])
  @@map("auth_lockouts")
}

model UserSuspension {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  reason    String    @db.VarChar(500)
  issuedBy  String    @db.Uuid
  startsAt  DateTime  @default(now())
  endsAt    DateTime? // null = indefinite
  liftedAt  DateTime?
  createdAt DateTime  @default(now())

  user User @relation("SuspendedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endsAt])
  @@map("user_suspensions")
}

// =====================================================================
// Geography
// =====================================================================

model Country {
  id        String   @id @db.Uuid
  name      String   @db.VarChar(120)
  iso2      String   @unique @db.VarChar(2)
  phoneCode String   @db.VarChar(6)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states State[]

  @@map("countries")
}

model State {
  id        String   @id @db.Uuid
  countryId String   @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @db.VarChar(140)
  code      String?  @db.VarChar(10)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country   Country    @relation(fields: [countryId], references: [id])
  districts District[]
  cities    City[]
  listings  Listing[]

  @@unique([countryId, slug])
  @@map("states")
}

model District {
  id        String   @id @db.Uuid
  stateId   String   @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @db.VarChar(140)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state    State     @relation(fields: [stateId], references: [id])
  cities   City[]
  listings Listing[]

  @@unique([stateId, slug])
  @@map("districts")
}

model City {
  id         String                                 @id @db.Uuid
  stateId    String                                 @db.Uuid
  districtId String?                                @db.Uuid
  name       String                                 @db.VarChar(120)
  // Globally unique so /hyderabad works as a landing-page URL without a state segment.
  slug       String                                 @unique @db.VarChar(140)
  nameTe     String?                                @db.VarChar(160)
  nameHi     String?                                @db.VarChar(160)
  latitude   Decimal                                @db.Decimal(10, 7)
  longitude  Decimal                                @db.Decimal(10, 7)
  geo        Unsupported("geography(Point, 4326)")?
  isActive   Boolean                                @default(true)
  isLaunched Boolean                                @default(false) // controls which cities the app offers at launch
  population Int?
  tier       Int? // 7th CPC HRA class: 1 = Tier 1 / X, 2 = Tier 2 / Y, 3 = Tier 3 / Z
  createdAt  DateTime                               @default(now())
  updatedAt  DateTime                               @updatedAt

  state           State            @relation(fields: [stateId], references: [id])
  district        District?        @relation(fields: [districtId], references: [id])
  localities      Locality[]
  pincodes        Pincode[]
  addresses       Address[]
  savedLocations  SavedLocation[]
  businesses      Business[]
  listings        Listing[]
  searchQueryLogs SearchQueryLog[]

  @@index([stateId, isActive])
  @@index([name])
  @@map("cities")
}

model Locality {
  id         String                                 @id @db.Uuid
  cityId     String                                 @db.Uuid
  name       String                                 @db.VarChar(140)
  slug       String                                 @db.VarChar(160)
  // The sub-district: mandal in Telangana and Andhra, taluk in the south, tehsil in the
  // north, block in the east. Stored here rather than in its own table because it is read
  // as part of an address and never browsed as an index of its own.
  mandal     String?                                @db.VarChar(140)
  postalCode String?                                @db.VarChar(12)
  latitude   Decimal?                               @db.Decimal(10, 7)
  longitude  Decimal?                               @db.Decimal(10, 7)
  geo        Unsupported("geography(Point, 4326)")?
  isActive   Boolean                                @default(true)
  createdAt  DateTime                               @default(now())
  updatedAt  DateTime                               @updatedAt

  city           City            @relation(fields: [cityId], references: [id])
  addresses      Address[]
  savedLocations SavedLocation[]
  listings       Listing[]

  @@unique([cityId, slug])
  @@index([postalCode])
  @@map("localities")
}

/// Every Indian postal code, so the platform works outside the launched cities.
///
/// One row per pincode, not per post office: India Post lists ~155,000 offices across
/// ~19,300 codes, and a user typing "500081" wants one place, not forty. The centroid is
/// the mean of that code's offices, which is accurate enough to anchor a radius search —
/// pincodes are small, and the alternative (asking for GPS) is a permission most people
/// decline.
model Pincode {
  code          String                                 @id @db.VarChar(6)
  /// Best-known place name for the code — the office name that appears most often.
  name          String                                 @db.VarChar(140)
  districtName  String                                 @db.VarChar(120)
  /// The sub-district: mandal, taluk, tehsil or block depending on the state.
  mandal        String?                                @db.VarChar(140)
  stateName     String                                 @db.VarChar(120)
  latitude      Decimal                                @db.Decimal(10, 7)
  longitude     Decimal                                @db.Decimal(10, 7)
  geo           Unsupported("geography(Point, 4326)")?
  /// How many post offices share this code — a proxy for how coarse the centroid is.
  officeCount   Int                                    @default(1)
  /// Set where the pincode falls inside a city LocZ has launched in; null elsewhere.
  cityId        String?                                @db.Uuid
  isServiceable Boolean                                @default(true)
  createdAt     DateTime                               @default(now())
  updatedAt     DateTime                               @updatedAt

  city     City?     @relation(fields: [cityId], references: [id])
  listings Listing[]

  /// Typeahead on partial codes ("5000…") and on place name.
  @@index([name])
  @@index([districtName])
  @@index([stateName])
  @@index([cityId])
  @@map("pincodes")
}

model Address {
  id         String                                 @id @db.Uuid
  line1      String?                                @db.VarChar(200)
  line2      String?                                @db.VarChar(200)
  landmark   String?                                @db.VarChar(160)
  cityId     String                                 @db.Uuid
  localityId String?                                @db.Uuid
  postalCode String?                                @db.VarChar(12)
  latitude   Decimal?                               @db.Decimal(10, 7)
  longitude  Decimal?                               @db.Decimal(10, 7)
  geo        Unsupported("geography(Point, 4326)")?
  createdAt  DateTime                               @default(now())
  updatedAt  DateTime                               @updatedAt

  city       City       @relation(fields: [cityId], references: [id])
  locality   Locality?  @relation(fields: [localityId], references: [id])
  businesses Business[]

  @@index([cityId])
  @@map("addresses")
}

model SavedLocation {
  id         String                                 @id @db.Uuid
  userId     String                                 @db.Uuid
  label      String                                 @db.VarChar(60) // Home, Work, …
  cityId     String                                 @db.Uuid
  localityId String?                                @db.Uuid
  latitude   Decimal?                               @db.Decimal(10, 7)
  longitude  Decimal?                               @db.Decimal(10, 7)
  geo        Unsupported("geography(Point, 4326)")?
  radiusKm   Int                                    @default(10)
  isDefault  Boolean                                @default(false)
  createdAt  DateTime                               @default(now())
  updatedAt  DateTime                               @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  city     City      @relation(fields: [cityId], references: [id])
  locality Locality? @relation(fields: [localityId], references: [id])

  @@index([userId])
  // Exactly one default per user is enforced by a partial unique index in the SQL migration
  // (Prisma cannot express `WHERE is_default`).
  @@map("saved_locations")
}

// =====================================================================
// Businesses
// =====================================================================

model Business {
  id             String                                 @id @db.Uuid
  /// Nullable because a directory record has no owner and never did. A placeholder user
  /// would be a lie the whole platform then has to work around; `ownerId IS NULL` is
  /// exactly the "unclaimed" query, and it is honest.
  ownerId        String?                                @db.Uuid
  name           String                                 @db.VarChar(180)
  slug           String                                 @unique @db.VarChar(200)
  categoryId     String                                 @db.Uuid
  description    String?                                @db.Text
  logoMediaId    String?                                @db.Uuid
  coverMediaId   String?                                @db.Uuid
  addressId      String?                                @db.Uuid
  cityId         String                                 @db.Uuid
  latitude       Decimal?                               @db.Decimal(10, 7)
  longitude      Decimal?                               @db.Decimal(10, 7)
  geo            Unsupported("geography(Point, 4326)")?
  primaryPhone   String?                                @db.VarChar(20)
  secondaryPhone String?                                @db.VarChar(20)
  whatsappNumber String?                                @db.VarChar(20)
  email          String?                                @db.VarChar(180)
  website        String?                                @db.VarChar(255)
  businessType   BusinessType                           @default(RETAIL_STORE)

  /// Scale and offering, asked of every seller at sign-up and of every claimant.
  ///
  /// Nullable because four million imported records predate the question and nobody may
  /// answer it on the shop's behalf — a guess here would be exactly the invented claim the
  /// description composer refuses to make. Null reads as "not stated yet", which is honest,
  /// and claiming the business is what fills it in.
  scale       BusinessScale?
  offering    OfferingType?
  claimStatus BusinessClaimStatus @default(OWNER_CREATED)

  /// The pincode this business sits in. Cities are districts here, so a city alone cannot
  /// answer "what is in 500081", which is the unit people actually search by.
  pincodeCode String? @db.VarChar(6)

  /// What this business actually sells or does, in the words a customer would type.
  ///
  /// Category vocabulary can only ever reach category level: it makes a kirana shop findable
  /// by "kirana" and "grocery store", never by "toor dal" or "bed bug spray". Those are the
  /// searches people really run, and no taxonomy that stops at the category can answer them.
  /// So the shop gets to say what is on its shelves.
  ///
  /// An array rather than free text because these are matched and shown as discrete terms,
  /// and because a paragraph would be stuffed with everything the owner ever hoped to rank
  /// for. A bounded list of short terms is harder to abuse and easier to moderate.
  keywords String[]

  /// Public profiles this business is known by elsewhere — Facebook, Instagram, and the like.
  ///
  /// Emitted as schema.org `sameAs`, which is how a search engine ties this page to an entity
  /// it already knows about rather than treating it as an unrelated page that happens to share
  /// a name. That is worth more to an unclaimed directory record than any amount of prose,
  /// because it is corroboration from outside LocZ.
  ///
  /// URLs only, exactly as the source gave them. Never a handle we assembled ourselves: a
  /// guessed profile URL is a link to somebody else's account.
  socialLinks String[]

  /// Where an imported record came from, and under what licence.
  ///
  /// Not optional bookkeeping: ODbL and CDLA both require attribution to travel with the
  /// data. Importing without these would breach the licence, and a record whose provenance
  /// is unknown cannot be defended if someone disputes it.
  sourceName      String?  @db.VarChar(120)
  sourceRecordId  String?  @db.VarChar(200)
  licenceName     String?  @db.VarChar(80)
  attributionText String?  @db.VarChar(400)
  /// How much the pipeline trusts this record, 0 to 1. Null for anything a person created.
  confidenceScore Decimal? @db.Decimal(3, 2)

  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  isPremium          Boolean            @default(false) // premium profile — inactive in Phase 1
  isActive           Boolean            @default(true)
  viewCount          Int                @default(0)
  saveCount          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  owner                User?                 @relation("BusinessOwner", fields: [ownerId], references: [id])
  category             Category              @relation(fields: [categoryId], references: [id])
  address              Address?              @relation(fields: [addressId], references: [id])
  city                 City                  @relation(fields: [cityId], references: [id])
  staff                BusinessStaff[]
  hours                BusinessHour[]
  holidays             BusinessHoliday[]
  serviceAreas         ServiceArea[]
  claims               BusinessClaim[]
  listings             Listing[]
  requirementResponses RequirementResponse[]
  savedBy              SavedBusiness[]
  slugAliases          BusinessSlugAlias[]

  /// Full-text document for business search, maintained by Postgres itself.
  ///
  /// `Unsupported` because Prisma cannot express a generated tsvector column; it is
  /// declared here only so `prisma migrate` does not try to drop it. Nothing reads it
  /// through the client — `BusinessSearchService` queries it with raw SQL.
  ///
  /// Generated rather than derived by the application on write: a column the database
  /// computes cannot fall out of step with the row, which is exactly how the previous
  /// Meilisearch index came to hold 400 of 3.4 million businesses without anyone noticing.
  searchDoc Unsupported("tsvector")?

  /// One import cannot create the same source record twice.
  @@unique([sourceName, sourceRecordId])
  @@index([ownerId])
  // City + category browse, the main business directory query.
  @@index([cityId, categoryId, isActive])
  @@index([verificationStatus])
  @@index([businessType])
  @@index([pincodeCode, claimStatus])
  @@map("businesses")
}

/// A URL a business used to live at.
///
/// The imported records were slugged `name-000j-hrcf`, where the last two segments are an
/// import batch number and a disambiguator — machine noise that told a reader and a search
/// engine nothing. Re-slugging them to `name-locality-city` is worth doing, but three and a
/// half million URLs are already indexed, linked and shared, and a slug change without this
/// table turns every one of them into a 404.
///
/// So every previous slug is kept and resolves to its business, which then redirects to the
/// current URL. Rows are never deleted: a link that worked once must keep working.
model BusinessSlugAlias {
  slug       String   @id @db.VarChar(200)
  businessId String   @db.Uuid
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_slug_aliases")
}

model BusinessStaff {
  id          String    @id @db.Uuid
  businessId  String    @db.Uuid
  userId      String    @db.Uuid
  role        String    @db.VarChar(40) // MANAGER | EDITOR | VIEWER
  permissions String[] // e.g. listing:create, offer:publish, enquiry:reply
  invitedAt   DateTime  @default(now())
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_staff")
}

model BusinessHour {
  id         String   @id @db.Uuid
  businessId String   @db.Uuid
  dayOfWeek  Int // 0 = Sunday
  opensAt    String   @db.VarChar(5) // "09:30"
  closesAt   String   @db.VarChar(5)
  isClosed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek, opensAt])
  @@map("business_hours")
}

model BusinessHoliday {
  id         String   @id @db.Uuid
  businessId String   @db.Uuid
  date       DateTime @db.Date
  reason     String?  @db.VarChar(120)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@map("business_holidays")
}

model ServiceArea {
  id         String   @id @db.Uuid
  businessId String   @db.Uuid
  cityId     String?  @db.Uuid
  localityId String?  @db.Uuid
  radiusKm   Int?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([cityId])
  @@map("service_areas")
}

// =====================================================================
// Categories & dynamic attributes
// =====================================================================

model Category {
  id       String  @id @db.Uuid
  parentId String? @db.Uuid
  name     String  @db.VarChar(140)
  nameTe   String? @db.VarChar(160)
  nameHi   String? @db.VarChar(160)
  slug     String  @unique @db.VarChar(160)

  /// What people actually type when they want this category.
  ///
  /// The problem this solves: a directory record scraped from an open dataset has a name, a
  /// category and a location, and nothing else. It has no menu. Somebody searching "biryani"
  /// will never match "Paradise Restaurant" on its own text — but the category knows that a
  /// restaurant is where biryani comes from, so the search terms carry it.
  ///
  /// Data rather than code, and per category rather than per record, so a few hundred terms
  /// make four million imported businesses findable. Generating phrase combinations instead
  /// would be larger, never complete, and stale the moment somebody opens a shawarma stall.
  ///
  /// All three languages in one list. A Telugu speaker typing బిర్యానీ and an English speaker
  /// typing biryani are looking for the same shop.
  searchTerms String[]

  /// Exists for the business directory, and is never offered when somebody posts.
  ///
  /// The imported directory needs categories like `hospitals-and-clinics` and
  /// `tyre-and-battery-stores` so four million businesses can be classified and found. None
  /// of those belong in the posting flow: a person listing a used phone has no business
  /// being shown "hospitals and clinics", and a category list that long is a category list
  /// nobody reads.
  ///
  /// So these are excluded from the public category tree and remain fully searchable. The
  /// alternative — marking them inactive — would take them out of search too, which is the
  /// one thing they exist for.
  isDirectoryOnly Boolean       @default(false)
  description     String?       @db.VarChar(500)
  iconKey         String?       @db.VarChar(80)
  // Which listing types may use this category — lets one tree serve products, jobs and offers.
  listingTypes    ListingType[]
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true)
  seoTitle        String?       @db.VarChar(180)
  seoDescription  String?       @db.VarChar(300)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  parent          Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]          @relation("CategoryTree")
  attributes      CategoryAttribute[]
  listings        Listing[]
  subListings     Listing[]           @relation("ListingSubcategory")
  businesses      Business[]
  searchQueryLogs SearchQueryLog[]

  // Renders the category tree for a listing type in one indexed scan.
  @@index([parentId, sortOrder])
  @@index([isActive])
  @@map("categories")
}

model CategoryAttribute {
  id           String            @id @db.Uuid
  categoryId   String            @db.Uuid
  key          String            @db.VarChar(60) // brand, model, condition, experience …
  label        String            @db.VarChar(120)
  labelTe      String?           @db.VarChar(140)
  labelHi      String?           @db.VarChar(140)
  dataType     AttributeDataType
  // SELECT / MULTI_SELECT choices: [{ value, label, labelTe, labelHi }]
  options      Json?
  unit         String?           @db.VarChar(20) // km, years, ₹ …
  isRequired   Boolean           @default(false)
  isFilterable Boolean           @default(false) // exposed as a Meilisearch facet
  isSearchable Boolean           @default(false)
  minValue     Decimal?          @db.Decimal(14, 2)
  maxValue     Decimal?          @db.Decimal(14, 2)
  sortOrder    Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  category Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values   ListingAttributeValue[]

  @@unique([categoryId, key])
  @@index([categoryId, sortOrder])
  @@map("category_attributes")
}

model ListingAttributeValue {
  id          String    @id @db.Uuid
  listingId   String    @db.Uuid
  attributeId String    @db.Uuid
  valueText   String?   @db.VarChar(300)
  valueNumber Decimal?  @db.Decimal(16, 4)
  valueBool   Boolean?
  valueDate   DateTime?
  valueJson   Json? // MULTI_SELECT
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  listing   Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  // One value per attribute per listing.
  @@unique([listingId, attributeId])
  // Filtering by attribute value in Postgres (Meilisearch handles the fast path).
  @@index([attributeId, valueText])
  @@index([attributeId, valueNumber])
  @@map("listing_attribute_values")
}

// =====================================================================
// Listings — base entity (ADR-0004)
// =====================================================================

model Listing {
  id         String      @id @db.Uuid
  type       ListingType
  ownerId    String      @db.Uuid
  businessId String?     @db.Uuid

  /// The business whose page this requirement was raised from.
  ///
  /// Distinct from businessId, which means "posted by this business". An unclaimed directory
  /// record has nobody to message, so asking whether they stock something becomes a
  /// requirement instead of a dead end — and the count of them is the only honest claim
  /// pitch there is: not "claim your listing" but "four people asked about your shop this
  /// week, and nobody could answer them".
  promptedByBusinessId String?          @db.Uuid
  title                String           @db.VarChar(160)
  // Unique across all listings so a listing has one canonical shareable URL.
  slug                 String           @unique @db.VarChar(200)
  description          String           @db.Text
  categoryId           String           @db.Uuid
  subcategoryId        String?          @db.Uuid
  status               ListingStatus    @default(DRAFT)
  moderationStatus     ModerationStatus @default(PENDING)
  moderationScore      Int?
  rejectionReason      String?          @db.VarChar(500)

  // Location — administrative ids for cheap filtering, geo for radius search.
  cityId          String                                 @db.Uuid
  districtId      String?                                @db.Uuid
  stateId         String?                                @db.Uuid
  localityId      String?                                @db.Uuid
  postalCode      String?                                @db.VarChar(12)
  pincodeCode     String?                                @db.VarChar(6)
  addressLine     String?                                @db.VarChar(240)
  latitude        Decimal?                               @db.Decimal(10, 7)
  longitude       Decimal?                               @db.Decimal(10, 7)
  geo             Unsupported("geography(Point, 4326)")?
  serviceRadiusKm Int?
  isRemote        Boolean                                @default(false)

  contactPreference ContactPreference @default(IN_APP_ONLY)
  contactPhone      String?           @db.VarChar(20)
  showPhonePublicly Boolean           @default(false)
  visibility        Visibility        @default(PUBLIC)

  publishedAt DateTime?
  expiresAt   DateTime?
  soldAt      DateTime?

  viewCount    Int @default(0)
  saveCount    Int @default(0)
  reportCount  Int @default(0)
  enquiryCount Int @default(0)

  // Monetisation-ready flags — schema present, no payment path in Phase 1.
  isFeatured    Boolean   @default(false)
  featuredUntil DateTime?
  isSponsored   Boolean   @default(false)
  isVerified    Boolean   @default(false)

  // Normalised hash of title+price+owner, used for duplicate detection at moderation time.
  duplicateHash   String?   @db.VarChar(64)
  searchIndexedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner       User      @relation("ListingOwner", fields: [ownerId], references: [id])
  business    Business? @relation(fields: [businessId], references: [id])
  category    Category  @relation(fields: [categoryId], references: [id])
  subcategory Category? @relation("ListingSubcategory", fields: [subcategoryId], references: [id])
  city        City      @relation(fields: [cityId], references: [id])
  district    District? @relation(fields: [districtId], references: [id])
  state       State?    @relation(fields: [stateId], references: [id])
  locality    Locality? @relation(fields: [localityId], references: [id])
  pincode     Pincode?  @relation(fields: [pincodeCode], references: [code])

  media                  ListingMedia[]
  attributeValues        ListingAttributeValue[]
  marketplace            MarketplaceDetail?
  buyerRequirement       BuyerRequirementDetail?
  offeredForRequirements RequirementResponse[]   @relation("OfferedForRequirement")
  offer                  OfferDetail?
  job                    JobDetail?
  service                ServiceDetail?
  rental                 RentalDetail?
  event                  EventDetail?
  savedBy                SavedListing[]
  views                  RecentlyViewed[]
  conversations          Conversation[]
  reports                Report[]
  moderationActions      ModerationAction[]
  placements             FeaturedPlacement[]

  // Home feed and city landing pages: filter by type+status+city, sort by recency.
  @@index([type, status, cityId, publishedAt(sort: Desc)])
  // Category landing pages.
  @@index([categoryId, status, publishedAt(sort: Desc)])
  // "My listings" dashboard.
  @@index([ownerId, status, createdAt(sort: Desc)])
  // Business profile tabs.
  @@index([businessId, type, status])
  // Expiry sweeper — narrowed further by a partial index in the SQL migration.
  @@index([status, expiresAt])
  // Moderation queue ordering.
  @@index([moderationStatus, createdAt])
  @@index([duplicateHash])
  // "Ads in my pincode" — the primary query once the platform is open everywhere.
  @@index([pincodeCode, status, publishedAt(sort: Desc)])
  @@index([promptedByBusinessId])
  @@map("listings")
}

model ListingMedia {
  id             String      @id @db.Uuid
  listingId      String      @db.Uuid
  status         MediaStatus @default(PENDING_UPLOAD)
  storageKey     String      @db.VarChar(300) // original object key
  thumbKey       String?     @db.VarChar(300) // 320px
  cardKey        String?     @db.VarChar(300) // 720px
  fullKey        String?     @db.VarChar(300) // 1600px
  avifKey        String?     @db.VarChar(300)
  mimeType       String      @db.VarChar(60)
  sizeBytes      Int?
  width          Int?
  height         Int?
  blurhash       String?     @db.VarChar(60)
  // Exact bytes. Catches the same file uploaded again, including by another account.
  sha256         String?     @db.VarChar(64)
  // A difference hash of the image content, so a re-crop, a re-compression or a small
  // watermark still resolves to something close. Compared by Hamming distance.
  perceptualHash String?     @db.VarChar(32)
  sortOrder      Int         @default(0)
  isPrimary      Boolean     @default(false)
  failureReason  String?     @db.VarChar(300)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  listing    Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  safetyCase MediaSafetyCase?

  @@index([listingId, sortOrder])
  // Sweeper for uploads that were requested but never confirmed.
  @@index([status, createdAt])
  // "Has this picture been posted before, and by whom?"
  @@index([sha256])
  @@index([perceptualHash])
  @@map("listing_media")
}

// ---------- Type-specific extensions (1:1 with Listing) ----------

model MarketplaceDetail {
  listingId         String        @id @db.Uuid
  price             Decimal?      @db.Decimal(12, 2)
  isNegotiable      Boolean       @default(false)
  isFree            Boolean       @default(false)
  condition         ItemCondition @default(GOOD)
  isNewItem         Boolean       @default(false)
  brand             String?       @db.VarChar(120)
  model             String?       @db.VarChar(120)
  purchaseYear      Int?
  hasWarranty       Boolean       @default(false)
  warrantyDetails   String?       @db.VarChar(240)
  deliveryAvailable Boolean       @default(false)
  pickupAvailable   Boolean       @default(true)
  quantity          Int           @default(1)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Price-range filtering and price sorting in Postgres fallback queries.
  @@index([price])
  @@index([condition])
  @@map("marketplace_details")
}

model BuyerRequirementDetail {
  listingId          String         @id @db.Uuid
  budgetMin          Decimal?       @db.Decimal(12, 2)
  budgetMax          Decimal?       @db.Decimal(12, 2)
  requiredBy         DateTime?
  quantity           Int?
  preferredCondition ItemCondition?

  /// How far the buyer is willing to look. Distinct from `Listing.serviceRadiusKm`, which
  /// describes how far a *seller* travels; a requirement is asking the opposite question.
  searchRadiusKm Int?

  fulfilment FulfilmentPreference @default(EITHER)

  /// Closed by the buyer once they have what they needed. Kept rather than deleted: an
  /// unfulfilled requirement that expired is the most valuable signal the platform
  /// collects, because it names demand nobody in the area could meet.
  fulfilledAt DateTime?

  /// Denormalised so a requirement card can show "3 sellers replied" without counting rows
  /// for every card in a feed. Maintained in the same transaction as the response.
  responseCount Int @default(0)

  listing   Listing               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  responses RequirementResponse[]

  @@index([budgetMax])
  @@index([fulfilledAt])
  @@map("buyer_requirement_details")
}

/// A seller's answer to a buyer requirement.
///
/// Its own table rather than a message, because an answer is structured: a buyer scanning
/// six replies wants to see "available, 1,400" against "can arrange, by Friday" without
/// reading six conversations. The chat is where the deal happens; this is how it starts.
model RequirementResponse {
  id          String                  @id @db.Uuid
  listingId   String                  @db.Uuid
  responderId String                  @db.Uuid
  /// Set when answering on behalf of a business, so the buyer sees the shop rather than the
  /// staff member who happened to be logged in.
  businessId  String?                 @db.Uuid
  kind        RequirementResponseKind

  /// What the seller is asking, when it differs from the buyer's budget.
  offeredPrice     Decimal?  @db.Decimal(12, 2)
  /// For CAN_ARRANGE, MADE_TO_ORDER and AVAILABLE_LATER, when it could be ready.
  availableFrom    DateTime?
  /// A short note. Not a substitute for the chat, which is where the conversation goes.
  message          String?   @db.VarChar(500)
  /// The seller's own listing, when they have one for exactly this.
  offeredListingId String?   @db.Uuid

  /// Opened when the buyer engages, so a response and its conversation stay linked.
  conversationId String? @db.Uuid

  withdrawnAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  requirement    BuyerRequirementDetail @relation(fields: [listingId], references: [listingId], onDelete: Cascade)
  responder      User                   @relation("RequirementResponder", fields: [responderId], references: [id], onDelete: Cascade)
  business       Business?              @relation(fields: [businessId], references: [id], onDelete: SetNull)
  offeredListing Listing?               @relation("OfferedForRequirement", fields: [offeredListingId], references: [id], onDelete: SetNull)

  /// One answer per seller per requirement. A seller who changes their mind edits their
  /// response; they do not add a second. This is the cheapest and most effective anti-spam
  /// control available here, and it is enforced by the database rather than by a service
  /// that could be bypassed by a second code path.
  @@unique([listingId, responderId])
  @@index([listingId, createdAt(sort: Desc)])
  @@index([responderId, createdAt(sort: Desc)])
  @@map("requirement_responses")
}

model OfferDetail {
  listingId              String   @id @db.Uuid
  originalPrice          Decimal? @db.Decimal(12, 2)
  offerPrice             Decimal? @db.Decimal(12, 2)
  discountPercentage     Int?
  couponCode             String?  @db.VarChar(40)
  startsAt               DateTime
  endsAt                 DateTime
  redemptionInstructions String?  @db.Text
  termsAndConditions     String?  @db.Text
  limitedQuantity        Int?
  redeemedCount          Int      @default(0)
  isOnline               Boolean  @default(false)
  isInStore              Boolean  @default(true)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // "Offers valid now" — the primary offers query.
  @@index([endsAt])
  @@index([startsAt, endsAt])
  @@map("offer_details")
}

model JobDetail {
  listingId            String         @id @db.Uuid
  companyName          String         @db.VarChar(180)
  employmentType       EmploymentType
  workplaceType        WorkplaceType
  salaryMin            Decimal?       @db.Decimal(12, 2)
  salaryMax            Decimal?       @db.Decimal(12, 2)
  salaryPeriod         SalaryPeriod   @default(MONTHLY)
  isSalaryVisible      Boolean        @default(true)
  experienceMinYears   Int?
  experienceMaxYears   Int?
  educationRequirement String?        @db.VarChar(180)
  skills               String[]
  openings             Int            @default(1)
  applicationDeadline  DateTime?
  applyMethod          String         @db.VarChar(30) // IN_APP | EXTERNAL_LINK | WALK_IN | PHONE
  externalApplyUrl     String?        @db.VarChar(400)
  walkInDetails        String?        @db.Text
  filledAt             DateTime?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([employmentType, workplaceType])
  @@index([salaryMin])
  @@map("job_details")
}

model ServiceDetail {
  listingId       String   @id @db.Uuid
  serviceType     String?  @db.VarChar(120)
  priceFrom       Decimal? @db.Decimal(12, 2)
  priceTo         Decimal? @db.Decimal(12, 2)
  pricingUnit     String?  @db.VarChar(40) // per hour, per visit …
  experienceYears Int?
  availability    String?  @db.VarChar(180)
  servesAtHome    Boolean  @default(false)
  servesOnline    Boolean  @default(false)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("service_details")
}

model RentalDetail {
  listingId       String    @id @db.Uuid
  propertyType    String?   @db.VarChar(80) // ROOM | FLAT | HOUSE | SHOP | PG …
  rentAmount      Decimal?  @db.Decimal(12, 2)
  depositAmount   Decimal?  @db.Decimal(12, 2)
  rentPeriod      String    @default("MONTHLY") @db.VarChar(20)
  bedrooms        Int?
  bathrooms       Int?
  areaSqft        Int?
  furnishing      String?   @db.VarChar(40)
  availableFrom   DateTime?
  preferredTenant String?   @db.VarChar(60)
  amenities       String[]

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([rentAmount])
  @@map("rental_details")
}

model EventDetail {
  listingId   String    @id @db.Uuid
  startsAt    DateTime
  endsAt      DateTime?
  venueName   String?   @db.VarChar(180)
  isFreeEntry Boolean   @default(true)
  ticketPrice Decimal?  @db.Decimal(12, 2)
  ticketUrl   String?   @db.VarChar(400)
  organiser   String?   @db.VarChar(180)
  capacity    Int?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([startsAt])
  @@map("event_details")
}

// =====================================================================
// Engagement
// =====================================================================

model SavedListing {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  listingId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Makes saving idempotent and powers "is this saved?" in one lookup.
  @@unique([userId, listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_listings")
}

