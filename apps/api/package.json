{
  "name": "@locz/api",
  "version": "0.1.0",
  "private": true,
  "description": "LocZ backend API — NestJS modular monolith",
  "scripts": {
    "build": "nest build",
    "db:activate-india": "ts-node prisma/activate-india.ts",
    "db:generate": "prisma generate",
    "db:generate-load": "ts-node prisma/generate-load.ts",
    "db:import-pincodes": "ts-node prisma/import-pincodes.ts",
    "db:import-villages": "ts-node prisma/import-villages.ts",
    "db:seed-tiers": "ts-node prisma/seed-city-tiers.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "openapi": "ts-node -P tsconfig.tools.json scripts/export-openapi.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@locz/public-brands": "*",
    "@aws-sdk/client-rekognition": "^3.1095.0",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/pg": "^8.20.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.81.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.1",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "meilisearch": "^0.60.0",
    "nestjs-pino": "^4.6.1",
    "nsfwjs": "^4.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "prisma": "^7.9.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
