# Next.js writes this file itself, and writes it differently depending on which command ran
# last: `next dev` points it at .next/dev/types, `next build` points it at .next/types. Tracking
# it therefore makes a clean worktree impossible while the development stack is running, which
# is exactly when the release gate needs one — the gate's own stack-dependent stages guaranteed
# the immutability check it runs alongside them would fail. Nothing needs it committed: the
# typecheck passes without it and every build recreates it.
next-env.d.ts

# Local UI preview artifacts
.ui-preview/
.preview-server.log
.preview-server.err.log
.premium-preview.log
.premium-preview.err.log
.ui-preview-server.err.log
.ui-preview-server.out.log

# Signing secrets — upload keystore, never commit
locz-signing-DO-NOT-SHARE/
*.jks
*.keystore
key.properties

# Overture extracts and enrichment working files — hundreds of MB, rebuildable from
# the public release and from the database. Never in git.
/var/

# DuckDB spill files from local data work.
/.tmp/

# OSM extracts — 1.8GB, rebuildable from Geofabrik.
/var/osm/
.artifacts/
