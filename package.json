{
  "name": "locz",
  "private": true,
  "version": "0.1.0",
  "description": "LocZ \u2014 location-first local discovery platform",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/admin",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "acceptance": "node scripts/acceptance.mjs",
    "acceptance:admin": "node scripts/acceptance-admin.mjs",
    "acceptance:all": "node scripts/acceptance-all.mjs",
    "acceptance:browser": "node scripts/acceptance-browser.mjs",
    "acceptance:business-safety": "node scripts/acceptance-browser.mjs --business-safety",
    "acceptance:filters": "node scripts/acceptance-filters.mjs",
    "acceptance:jobs": "node scripts/acceptance-jobs.mjs",
    "acceptance:localized-browser": "node scripts/acceptance-localized-browser.mjs",
    "acceptance:performance": "node scripts/acceptance-performance.mjs",
    "acceptance:responsive": "node scripts/acceptance-responsive.mjs",
    "acceptance:search-browser": "node scripts/acceptance-search-browser.mjs",
    "acceptance:security": "node scripts/acceptance-security.mjs",
    "acceptance:web": "node scripts/acceptance-web.mjs",
    "build": "npm run build --workspaces --if-present",
    "check:hardcoded": "node scripts/check-hardcoded-text.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "db:migrate": "npm run db:migrate -w @locz/api",
    "db:seed": "npm run db:seed -w @locz/api",
    "dev:admin": "npm run dev -w @locz/admin",
    "dev:api": "npm run start:dev -w @locz/api",
    "dev:web": "npm run dev -w @locz/web",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.dev.yml down",
    "docker:logs": "docker compose -f infrastructure/docker/docker-compose.dev.yml logs -f",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.dev.yml up -d",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "gate:release": "node scripts/release-gate.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "preflight:production": "node scripts/production-preflight.mjs",
    "prepare": "husky",
    "smoke:production": "node scripts/production-smoke.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:safety": "node scripts/verify-safety-workflow.mjs",
    "verify:safety-readiness": "node scripts/child-safety-readiness.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "apps/api/**/*.ts": [
      "prettier --write"
    ],
    "apps/{web,admin}/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "packages/**/*.ts": [
      "prettier --write"
    ],
    "apps/mobile/**/*.dart": [
      "dart format --line-length 100"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "apps/api/prisma/schema.prisma": [
      "prisma format --schema"
    ]
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "argon2": true,
    "msgpackr-extract": true,
    "prisma": true,
    "sharp": true,
    "unrs-resolver": true
  },
  "overrides": {
    "find-my-way": "9.7.0",
    "js-yaml": "5.2.2",
    "next": {
      "postcss": "8.5.18",
      "sharp": "0.35.3"
    },
    "valibot": "1.4.2"
  }
}
