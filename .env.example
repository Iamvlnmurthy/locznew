# =====================================================================
# LocZ — environment template. Copy to .env and fill in.
# NEVER commit .env. NEVER put secrets in NEXT_PUBLIC_* variables.
# =====================================================================

NODE_ENV=development
TZ=Asia/Kolkata

# ---------- API ----------
API_PORT=4000
API_GLOBAL_PREFIX=api
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------- PostgreSQL + PostGIS ----------
POSTGRES_USER=locz
POSTGRES_PASSWORD=locz_dev_password_change_me
POSTGRES_DB=locz
POSTGRES_PORT=5432

# Used only by scripts/restore.sh, which must CREATE DATABASE and install
# extensions — privileges the application role deliberately lacks. Leave unset
# to restore into an existing database as the application role.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
# Prisma opens a pool per process. The default is (cpus * 2 + 1), which with an API,
# a worker and a couple of replicas exhausts Postgres's default max_connections of 100.
# Set it explicitly and size it against your database: connection_limit * instances < max_connections.
DATABASE_URL="postgresql://locz:locz_dev_password_change_me@localhost:5432/locz?schema=public&connection_limit=10&pool_timeout=20"

# Used by migrations and introspection, which cannot run through a transaction pooler.
# Behind PgBouncer/Neon/Supabase this points at the unpooled endpoint while DATABASE_URL
# keeps ?pgbouncer=true. Connecting straight to Postgres, set it to the same URL without
# the pool parameters — Prisma rejects an EMPTY value, so it must always be set.
# Development only. `prisma migrate dev` needs CREATEDB to build its shadow
# database; the application role deliberately lacks it. Unused by migrate deploy.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/locz_shadow?schema=public"

DIRECT_DATABASE_URL="postgresql://locz:locz_dev_password_change_me@localhost:5432/locz?schema=public"

# ---------- Redis (cache + BullMQ) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# ---------- OTP ----------
# mock | msg91 | twilio
OTP_PROVIDER=mock
OTP_LENGTH=6
OTP_TTL_SECONDS=300
# Codes per phone per window. Three is right for production — a person who cannot sign in
# after three codes has a different problem, and each one costs money to send.
#
# It also sets the IP-wide ceiling at ten times this figure per hour, which is what a
# local stack runs into: every acceptance suite and browser test arrives from 127.0.0.1
# and shares that single bucket. Raise it locally (30 works) if sign-ins start stalling.
OTP_MAX_REQUESTS_PER_PHONE_PER_WINDOW=3
OTP_REQUEST_WINDOW_SECONDS=600
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
# Production SMS credentials — leave blank in development
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Object storage (Cloudflare R2 / S3-compatible; MinIO locally) ----------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=locz-media
STORAGE_ACCESS_KEY_ID=locz_minio
STORAGE_SECRET_ACCESS_KEY=locz_minio_dev_secret
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/locz-media
STORAGE_SIGNED_URL_TTL_SECONDS=900
MEDIA_MAX_FILE_SIZE_BYTES=10485760
MEDIA_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/heic
MEDIA_MAX_IMAGES_PER_LISTING=12

# ---------- Meilisearch ----------
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=locz_dev_meili_master_key
MEILI_LISTINGS_INDEX=listings

# ---------- Firebase Cloud Messaging ----------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---------- Email (transactional) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="LocZ <no-reply@locz.in>"

# ---------- Monitoring ----------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=debug

# ---------- Background jobs ----------
# Registers the repeatable BullMQ schedule. Set true on exactly one deployment
# (normally the worker) so several API replicas do not each re-register it.
SCHEDULER_ENABLED=true

# ---------- Rate limiting ----------
RATE_LIMIT_TTL_SECONDS=60
# Per-IP ceiling for the whole API. Keep this figure in production: it is the crude brake
# in front of everything else, and every real client stays far below it.
#
# A local stack is the one place it misleads. The acceptance suites and the browser tests
# all arrive from 127.0.0.1, so they share one bucket and throttle each other rather than
# any attacker — raise it locally (2000 works) if runs start stalling on 429s. The
# per-phone OTP limits are the ones that matter for abuse, and those stay untouched.
RATE_LIMIT_MAX_REQUESTS=120

# ---------- Listing lifecycle (days; 0 = no auto expiry) ----------
EXPIRY_DAYS_CLASSIFIED=30
EXPIRY_DAYS_PRODUCT=30
EXPIRY_DAYS_JOB=30
EXPIRY_DAYS_BUYER_REQUIREMENT=15
EXPIRY_DAYS_SERVICE=60
EXPIRY_DAYS_RENTAL=45
EXPIRY_DAYS_EVENT=0
EXPIRY_DAYS_BUSINESS_LISTING=0

# ---------- Web app (public values only) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY_SLUG=hyderabad
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Admin app ----------
NEXT_PUBLIC_ADMIN_API_BASE_URL=http://localhost:4000/api/v1
ADMIN_PORT=3001
