# Shared proxy settings, included by every location block.

proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;

# The API derives per-IP rate limits and audit entries from this — without it every
# request appears to come from the proxy and the limits become useless.
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;

# Generated when the client did not supply one, so every request is traceable.
proxy_set_header X-Correlation-Id $request_id;

proxy_set_header Connection "";

proxy_connect_timeout 5s;
proxy_send_timeout 60s;
# Image processing on upload confirmation is the slowest legitimate request.
proxy_read_timeout 60s;

proxy_buffering on;
proxy_buffer_size 8k;
proxy_buffers 16 8k;
