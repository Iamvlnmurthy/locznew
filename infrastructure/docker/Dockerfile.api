# syntax=docker/dockerfile:1
#
# LocZ API + worker. One image serves both: the worker is the same module graph started
# without an HTTP server, so there is no chance of the two drifting apart in production.

# ---------------------------------------------------------------------------
# Dependencies — cached separately from source so a code change does not reinstall.
# ---------------------------------------------------------------------------
FROM node:24-bookworm-slim AS deps
WORKDIR /app

# sharp and argon2 need build tooling only if a prebuilt binary is unavailable.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY packages/config/package.json packages/config/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/ui-tokens/package.json packages/ui-tokens/
COPY packages/public-brands/package.json packages/public-brands/

RUN npm ci --workspace @locz/api --include-workspace-root

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
FROM deps AS build
WORKDIR /app

COPY apps/api apps/api
COPY packages packages

# The Prisma client is generated against the schema in this image, so the runtime
# client can never be out of step with the migrations shipped alongside it.
RUN npx prisma generate --schema apps/api/prisma/schema.prisma \
    && npm run build --workspace @locz/api

# The `prisma` CLI is a devDependency, but the `migrate` service runs `prisma migrate
# deploy` from this very image — pruning it away would leave `npx` trying to download the
# CLI at deploy time, on a machine that may have no route to the npm registry. Keeping
# one package is cheaper than a migration that fails in production.
RUN npm prune --omit=dev --workspace @locz/api --include-workspace-root

# Reinstalled at the version the workspace pins, so the CLI running the migration is the
# same one the migrations were authored with.
RUN npm install --no-save --workspace @locz/api \
      "prisma@$(node -p "require('./apps/api/package.json').devDependencies.prisma")"

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM node:24-bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      openssl ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV TZ=Asia/Kolkata

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./dist
COPY --from=build /app/apps/api/prisma ./prisma
COPY --from=build /app/apps/api/package.json ./package.json

# Prisma 7 reads the datasource URL from this file rather than from schema.prisma, so
# without it `prisma migrate deploy` has nothing to connect to. It was the one file the
# image was missing, and it would have failed the first deploy, not a later one.
COPY --from=build /app/apps/api/prisma.config.ts ./prisma.config.ts

# Never root. The image writes nothing outside /tmp — media goes to object storage.
USER node

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://localhost:4000/api/v1/health/live || exit 1

# Overridden to `node dist/worker.js` for the worker service.
CMD ["node", "dist/main.js"]
