# syntax=docker/dockerfile:1
#
# Shared Dockerfile for both Next.js applications. Build with:
#   --build-arg APP=web    (or admin)

FROM node:24-bookworm-slim AS deps
WORKDIR /app
ARG APP=web

COPY package.json package-lock.json ./
COPY apps/${APP}/package.json apps/${APP}/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/ui-tokens/package.json packages/ui-tokens/
COPY packages/config/package.json packages/config/
COPY packages/validation/package.json packages/validation/
COPY packages/api-client/package.json packages/api-client/
COPY packages/public-brands/package.json packages/public-brands/

RUN npm ci --workspace @locz/${APP} --include-workspace-root

FROM deps AS build
WORKDIR /app
ARG APP=web

COPY apps/${APP} apps/${APP}
COPY packages packages

# NEXT_PUBLIC_* values are inlined at build time, so they are build args rather than
# runtime environment. Nothing secret may ever be passed here — these end up in the
# JavaScript bundle the browser downloads.
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build --workspace @locz/${APP}

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ARG APP=web

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV TZ=Asia/Kolkata

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/${APP}/.next ./.next
COPY --from=build /app/apps/${APP}/public ./public
COPY --from=build /app/apps/${APP}/package.json ./package.json
COPY --from=build /app/apps/${APP}/next.config.mjs ./next.config.mjs

USER node
EXPOSE 3000

CMD ["npx", "next", "start", "--port", "3000", "--hostname", "0.0.0.0"]
